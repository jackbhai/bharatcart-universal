# =====================================================================
# BharatCart — environment configuration.
# Copy to `.env` and fill in. Every variable is optional; unset values keep
# the safe demo defaults (local backend, simulated payments, demo gold rates).
# See docs/14-PRODUCTION.md for the full production checklist.
# =====================================================================

# --- Backend -------------------------------------------------------
# Which backend the app talks to: local | supabase | firebase | cloudflare
# local = browser-only demo mode, no account needed, data lives in localStorage.
VITE_BACKEND=local

# --- Supabase (recommended: Postgres + auth + storage + realtime in one) ---
# VITE_BACKEND=supabase
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGci...

# --- Firebase ---
# VITE_BACKEND=firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- Cloudflare (Workers API + Access) ---
# VITE_BACKEND=cloudflare
# VITE_CF_API_URL=https://your-worker.workers.dev
# VITE_CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# --- Payments ------------------------------------------------------
# Real payments only — there is no demo/simulated mode. Online payments
# need BOTH a publishable key AND your backend URL below; without both,
# checkout honestly offers Cash on Delivery instead.
# Mode is derived from the key prefix: rzp_test_/pk_test_ = Test (sandbox,
# no real money), rzp_live_/pk_live_ = Live (real money).

# Base URL of YOUR server. Required endpoints (see docs/14-PRODUCTION.md):
#   POST /payments/razorpay/create-order
#   POST /payments/razorpay/verify
#   POST /payments/stripe/create-intent
#   POST /payments/stripe/confirm
# VITE_PAYMENTS_API_URL=https://api.yourstore.com

# Publishable gateway keys (safe in the browser; also settable in admin
# Settings → Payments or the Integrations hub). Key SECRETS stay on your
# server only — never in the browser bundle.
# VITE_RAZORPAY_KEY_ID=rzp_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Gold rates (fine jewellery) -----------------------------------
# JSON endpoint returning { rates: { '24K': 8420, '22K': 7718, '18K': 6312, '14K': 4920 } }
# per gram in INR. Cached in memory for VITE_GOLD_RATE_TTL_MS (default 15 min).
# When unreachable/unset, the bundled DEMO table is used and the PDP shows
# "Indicative rate". Checkout snapshots record the source (live/demo/override).
# VITE_GOLD_RATE_URL=https://api.yourstore.com/api/gold-rates
# VITE_GOLD_RATE_TTL_MS=900000

# --- Integrations (admin: #/admin/integrations) ---------------------
# Every variable below is optional. The admin Integrations hub shows which
# are set ("Set"/"Missing") and tests the connection for real.
# Publishable keys (pk_, anon keys, measurement IDs) are safe in the
# browser — but remember: VITE_ variables ARE embedded in the client
# bundle. True secrets (service_role keys, API secrets, passwords) must
# stay on your backend and NEVER get a VITE_ prefix.
# See docs/15-INTEGRATIONS.md.

# --- Database ---
# Supabase (Postgres + auth + storage)
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGci...
# Firebase
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_PROJECT_ID=your-project-id
# Neon (serverless Postgres — connection string is a secret; prefer your backend)
# VITE_NEON_CONNECTION_STRING=postgresql://user:password@ep-xxxx.aws.neon.tech/dbname
# Custom REST backend
# VITE_REST_API_BASE=https://api.yourstore.com
# VITE_REST_API_KEY=

# --- Auth ---
# Clerk
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Custom JWT (JWKS)
# VITE_JWT_JWKS_URL=https://auth.yourstore.com/.well-known/jwks.json
# VITE_JWT_ISSUER=https://auth.yourstore.com/

# --- Payments (publishable keys only; secrets stay on your server) ---
# VITE_RAZORPAY_KEY_ID=rzp_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Storage ---
# Cloudinary
# VITE_CLOUDINARY_CLOUD_NAME=
# VITE_CLOUDINARY_UPLOAD_PRESET=
# S3-compatible (AWS S3 / Cloudflare R2 / MinIO — keys are secrets)
# VITE_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# VITE_S3_BUCKET=
# VITE_S3_ACCESS_KEY=
# VITE_S3_SECRET_KEY=

# --- SMS ---
# Twilio (auth token is a secret)
# VITE_TWILIO_ACCOUNT_SID=AC...
# VITE_TWILIO_AUTH_TOKEN=
# VITE_TWILIO_FROM=+14155552671
# MSG91 (auth key is a secret)
# VITE_MSG91_AUTH_KEY=

# --- Email (API keys are secrets) ---
# VITE_RESEND_API_KEY=re_...
# VITE_SENDGRID_API_KEY=SG....

# --- Analytics ---
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=yourstore.in

# --- Shipping ---
# Shiprocket (password is a secret)
# VITE_SHIPROCKET_EMAIL=you@yourstore.in
# VITE_SHIPROCKET_PASSWORD=

# --- Routing / deploy sub-path -------------------------------------------
# Sub-path the app is served from. The storefront uses clean history-API
# URLs, so the router needs to know the base. Local dev: leave as /.
# GitHub Pages project site: build with VITE_APP_BASENAME=/bharatcart-universal
VITE_APP_BASENAME=/
